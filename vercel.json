{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/games", "destination": "/games.html" },
    { "source": "/members", "destination": "/members.html" },
    { "source": "/join", "destination": "/join.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/account", "destination": "/account.html" }
  ],
  "redirects": [
    { "source": "/games.html", "destination": "/games", "permanent": true },
    { "source": "/members.html", "destination": "/members", "permanent": true },
    { "source": "/join.html", "destination": "/join", "permanent": true },
    { "source": "/register.html", "destination": "/register", "permanent": true },
    { "source": "/account.html", "destination": "/account", "permanent": true }
  ]
}
