# KillZone clean URLs
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Home page
  DirectoryIndex index.html

  # Redirect old .html URLs to clean URLs (preserve query strings)
  RewriteCond %{THE_REQUEST} \s/+games\.html(?:[?\s]) [NC]
  RewriteRule ^games\.html$ /games [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+members\.html(?:[?\s]) [NC]
  RewriteRule ^members\.html$ /members [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+join\.html(?:[?\s]) [NC]
  RewriteRule ^join\.html$ /join [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+register\.html(?:[?\s]) [NC]
  RewriteRule ^register\.html$ /register [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+account\.html(?:[?\s]) [NC]
  RewriteRule ^account\.html$ /account [R=301,L,NE]

  # Clean URLs -> actual HTML files
  RewriteRule ^games/?$ games.html [L]
  RewriteRule ^members/?$ members.html [L]
  RewriteRule ^join/?$ join.html [L]
  RewriteRule ^register/?$ register.html [L]
  RewriteRule ^account/?$ account.html [L]
</IfModule>
